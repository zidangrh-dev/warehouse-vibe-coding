# Contoh konfigurasi Nginx di VPS.
# Web statis (hasil `npx expo export -p web`) + proxy API/WebSocket/uploads.
# Ganti gudang.contoh.com dengan domainmu, lalu pasang HTTPS dengan certbot.
server {
    listen 80;
    server_name gudang.contoh.com;

    root /var/www/gudang-board;   # isi dengan folder dist hasil expo export
    index index.html;

    location / {
        try_files $uri /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /uploads/ {
        proxy_pass http://127.0.0.1:4000;
    }

    location /socket.io/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    client_max_body_size 12m;   # batas upload foto
}
