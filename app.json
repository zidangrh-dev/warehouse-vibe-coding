{
  "expo": {
    "name": "PickHub",
    "slug": "pickhub",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.pickhub.app",
      "adaptiveIcon": {
        "backgroundColor": "#0b5394",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Izinkan akses kamera untuk scan barcode"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan akses galeri untuk melampirkan foto barang"
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "777fc94b-fd75-427b-9428-d7007a9e11bc"
      }
    }
  }
}
