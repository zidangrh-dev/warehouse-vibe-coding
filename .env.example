# ============================================
# PickHub — Environment Variables
# ============================================
# Salin file ini ke .env dan isi nilainya.
# cp .env.example .env

# --- Database ---
# Untuk development lokal: tidak perlu diisi, server pakai embedded PostgreSQL otomatis.
# Untuk production (VPS): isi dengan URL PostgreSQL asli.
DATABASE_URL=postgres://gudang:PASSWORD_KUAT_ANDA@db:5432/gudang

# Password database (dipakai oleh docker-compose)
DB_PASSWORD=PASSWORD_KUAT_ANDA

# --- JWT Secret ---
# Ganti dengan string acak yang panjang untuk signing token login.
# Contoh generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang

# --- CORS (opsional) ---
# Origin web yang diizinkan (dipisah koma). Default mengizinkan localhost dev,
# apps-pickhub.cloud, dan IP VPS 202.10.44.147. Override untuk domain custom.
# ALLOWED_ORIGINS=https://apps-pickhub.cloud,https://domain-anda.com

# --- Server Port ---
PORT=4000

# --- Meilisearch (search engine) ---
# Untuk development lokal: tidak perlu diisi, default ke http://127.0.0.1:7700
# Untuk production (VPS): isi dengan URL Meilisearch.
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=your-master-key-here
